UPDATE livros 
SET capa_url = 'https://imgs.search.brave.com/EYFO9bdte0fS09UyULu3nS25Q5-SN6t1l6fJv0lKMSs/rs:fit:860:0:0:0/g:ce/aHR0cHM6Ly9odHRw/Mi5tbHN0YXRpYy5j/b20vRF9OUV9OUF85/MDc3ODMtTUxBODIx/NzM2MTg5NjJfMDIy/MDI1LU8ud2VicA' 
WHERE titulo = 'Binding 13';

ALTER TABLE livros 
ALTER COLUMN capa_url TYPE text;

DELETE FROM livros WHERE genero = 'Fantasia';   

SELECT * FROM livros;

TRUNCATE TABLE livros;

DELETE FROM livros WHERE genero = 'Ficção';

DELETE FROM livros WHERE genero = 'Suspense';

SELECT COUNT(*) AS total FROM livros;

SELECT 
    titulo,
    COUNT(*) AS quantidade
FROM livros
GROUP BY titulo
ORDER BY quantidade DESC;


CREATE TABLE mensagens_contato (
    id SERIAL PRIMARY KEY,                          -- Identificador da mensagem
    nome VARCHAR(100) NOT NULL,                     -- Nome do cliente/visitante
    email VARCHAR(150) NOT NULL,                    -- E-mail para retorno de contato
    mensagem TEXT NOT NULL,                         -- Texto com a dúvida, crítica ou sugestão
    criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP   -- Data e hora do envio
);

CREATE TABLE usuarios (
    id SERIAL PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    email VARCHAR(150) NOT NULL UNIQUE,
    senha VARCHAR(255) NOT NULL,
    criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE resenhas_videos (
    id SERIAL PRIMARY KEY,
    titulo_livro VARCHAR(200) NOT NULL,
    url_video VARCHAR(500) NOT NULL,
    resumo TEXT
);

CREATE TABLE livros (
    id SERIAL PRIMARY KEY,                          -- Identificador único do livro
    titulo VARCHAR(200) NOT NULL,                   -- Título do livro
    autor VARCHAR(100) NOT NULL,                    -- Nome do autor
    editora VARCHAR(100),                           -- Nome da editora
    genero VARCHAR(50) NOT NULL,                    -- Gênero (Romance, Ficção, Suspense, Terror, etc.)
    preco DECIMAL(10, 2) NOT NULL DEFAULT 0.00,     -- Preço de venda
    estrelas INT DEFAULT 5,                         -- Avaliação em estrelas (1 a 5)
    capa_url VARCHAR(500),                          -- Nome do arquivo da imagem (ex: dom_casmurro.jpg)
    total_leitores INT DEFAULT 0                    -- Quantidade de leitores para estatísticas
);


CREATE TABLE IF NOT EXISTS historico_leitura (
    id SERIAL PRIMARY KEY,
    usuario_id INT REFERENCES usuarios(id) ON DELETE CASCADE,
    livro_nome VARCHAR(200) NOT NULL,
    genero VARCHAR(50),
    tempo_leitura VARCHAR(50),
    paginas_lidas INT DEFAULT 0,
    total_paginas INT DEFAULT 0,
    progresso_pct INT DEFAULT 0,
    atualizado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE postagens_feed (
    id SERIAL PRIMARY KEY,                          -- Identificador da publicação
    usuario_id INT REFERENCES usuarios(id) ON DELETE CASCADE, -- ID do autor do post
    livro_nome VARCHAR(200) NOT NULL,               -- Nome do livro comentado
    comentario TEXT NOT NULL,                       -- Texto da opinião / resenha rápida
    progresso INT DEFAULT 0,                        -- Porcentagem de leitura no momento do post
    aba_categoria VARCHAR(50) DEFAULT 'Geral',      -- Categoria de exibição (Geral, Amigos, Minhas, Seguindo)
    criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP   -- Data/hora de envio da postagem
);

DROP TABLE IF EXISTS historico_leitura CASCADE;


-- 1. Adiciona a coluna 'is_admin' na tabela usuarios (por padrão todos nascem FALSE)
ALTER TABLE usuarios ADD COLUMN is_admin BOOLEAN DEFAULT FALSE;

-- 2. Promova o seu usuário para Administrador (substitua pelo seu e-mail de cadastro)
UPDATE usuarios SET is_admin = TRUE WHERE email = 'admin@gmail.com';




-- 1. Elimina todos os livros duplicados mantendo apenas a primeira cópia registrada
DELETE FROM livros a
USING livros b
WHERE a.id > b.id
  AND LOWER(TRIM(a.titulo)) = LOWER(TRIM(b.titulo));

-- 2. Cria uma trava de segurança que impede o banco de aceitar cadastros com títulos repetidos
ALTER TABLE livros ADD CONSTRAINT unique_livro_titulo UNIQUE (titulo);